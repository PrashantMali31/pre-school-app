TEST_DATABASE_URL=postgres://preschool:preschool@localhost:5434/preschool_test
NODE_ENV=development
# Platform revenue (GET /billing/platform/overview) allowlist — login emails of the SaaS owner.
PLATFORM_OWNER_EMAILS=
