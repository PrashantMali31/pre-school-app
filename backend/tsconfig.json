{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  // Tests are run by vitest (no tsc needed) and must NOT ship to production:
  // hosts like Render install prod-only deps, where vitest/@types are absent.
  "exclude": ["node_modules", "dist", "src/test"]
}
