# Local dev — Postgres via docker-compose at repo root.
DATABASE_URL=postgres://preschool:preschool@localhost:5434/preschool
JWT_SECRET=dev-only-change-me-min-32-chars-please
PORT=4000
FRONTEND_URL=http://localhost:3000
